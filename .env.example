# MLflow on Red Hat OpenShift AI
MLFLOW_TRACKING_AUTH=kubernetes-namespaced
MLFLOW_TRACKING_URI=https://your-mlflow-route.example.com/mlflow
# Override only if the agent is running in a different namespace than the target MLflow workspace
# MLFLOW_WORKSPACE=your-workspace
MLFLOW_EXPERIMENT=fsi-mortgage-demo

# llm-d OpenAI-compatible endpoint
LLM_BASE_URL=https://your-llm-d-route.example.com/v1
LLM_API_KEY=not-needed
LLM_MODEL=RedHatAI/Qwen3-14B-quantized.w4a16

# Gemini-backed MLflow judges
GEMINI_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
JUDGE_MODEL_URI=gemini:/gemini-2.5-flash

# Used only when JUDGE_MODEL_URI is overridden with an OpenAI-compatible model
# JUDGE_BASE_URL=https://your-llm-d-route.example.com/v1/chat/completions
